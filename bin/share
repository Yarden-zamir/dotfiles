#!/bin/sh
#
# Hoist local-only files out of a worktree and into <project>/_shared, then
# symlink them back — so every worktree of the repo sees the same file:
#
#   <project>/auth/.env  ->  <project>/_shared/.env   (moved)
#   <project>/auth/.env  ->  ../_shared/.env          (symlink, left behind)
#
#   share              suggest gitignored paths worth hoisting
#   share ls           list what is already shared, and its state here
#   share <path>...    hoist each path into _shared and symlink it back
#
# Only gitignored paths may be hoisted: a tracked file replaced by a symlink
# would show up as a change in every worktree. --force overrides.
#
# Build output is never suggested, and refused without --force. Hoist *inputs*
# (secrets, env, local config) — never *outputs*. Anything a build regenerates
# is per-branch: sharing it feeds one branch's artifacts to another, and two
# worktrees compiling at once will race on the same directory.
#
# usage: share [-f|--force] [ls | <path>...]

set -u
unset CDPATH

fail() {
  printf '🔴 %s\n' "$1" >&2
  exit 1
}

warn() {
  printf '🟠 %s\n' "$1" >&2
}

info() {
  printf '🟢 %s\n' "$1" >&2
}

usage() {
  printf 'usage: share [-f|--force] [ls | <path>...]\n'
}

# Local-only: nothing tracked would be replaced by a symlink, and git ignores it.
# Checking "no tracked files under it" rather than check-ignore alone, because
# check-ignore reports a *directory* as not-ignored even when all of its contents
# are — which is exactly the case git collapses to "<dir>/" when listing.
is_local() {
  [ -z "$(git ls-files -- "$1")" ] || return 1
  git check-ignore -q -- "$1" && return 0
  [ -n "$(git ls-files --others --ignored --exclude-standard --directory -- "$1")" ]
}

# Derived: regenerated by a build, per-branch, must never be shared.
is_derived() {
  case "${1##*/}" in
    node_modules | target | build | dist | out | bin | obj) return 0 ;;
    .gradle | .m2 | .stack-work | .cargo | .next | .nuxt | .turbo | .parcel-cache) return 0 ;;
    .venv | venv | __pycache__ | .tox | .eggs | *.egg-info) return 0 ;;
    .mypy_cache | .ruff_cache | .pytest_cache | .cache | coverage | .nyc_output) return 0 ;;
    .terraform | .sbt | .bsp | .metals | .bloop | .scala-build) return 0 ;;
    *.class | *.o | *.pyc | *.log) return 0 ;;
  esac
  return 1
}

force=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -f | --force)
      force=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*) fail "unknown option: $1" ;;
    *) break ;;
  esac
done

worktree=$(git rev-parse --show-toplevel 2>/dev/null) || fail 'not inside a Git worktree'
worktree=$(cd -- "$worktree" && pwd -P) || fail "could not resolve $worktree"
project=$(dirname "$worktree")
shared="$project/_shared"

[ -d "$project/.bare" ] || fail "not a bare + worktree container: $project"

linker=$(dirname -- "$0")/git-shared-link
[ -x "$linker" ] || fail "git-shared-link not found next to share"

# ---------------------------------------------------------------- share ls
if [ "${1:-}" = ls ]; then
  [ -d "$shared" ] || fail "no shared directory: $shared"

  found=0
  for source in $(cd "$shared" && find . ! -type d | sed 's|^\./||' | sort); do
    case "$source" in .DS_Store | */.DS_Store) continue ;; esac
    found=1
    target="$worktree/$source"
    if [ -L "$target" ]; then
      state='linked here'
    elif [ -e "$target" ]; then
      state='🟠 real file here, shadowing the shared one'
    else
      state='🟠 not linked here'
    fi
    printf '%s\t(%s)\n' "$source" "$state"
  done

  [ "$found" -eq 1 ] || info "nothing shared yet in $shared"
  exit 0
fi

# ---------------------------------------------------- share (no args): suggest
if [ "$#" -eq 0 ]; then
  candidates=$(cd "$worktree" && git ls-files --others --ignored --exclude-standard --directory) ||
    fail 'could not list ignored files'

  found=0
  for rel in $candidates; do
    case "$rel" in .DS_Store | */.DS_Store) continue ;; esac

    # git may list an ignored directory *and* files inside it; keep the directory.
    covered=0
    parent=${rel%/}
    while [ "$parent" != "${parent%/*}" ]; do
      parent=${parent%/*}
      case "
$candidates
" in *"
$parent/
"*) covered=1; break ;; esac
    done
    [ "$covered" -eq 1 ] && continue

    rel=${rel%/}
    is_derived "$rel" && continue
    [ -e "$shared/$rel" ] && continue
    [ -L "$worktree/$rel" ] && continue
    found=1
    printf '%s\n' "$rel"
  done

  if [ "$found" -eq 0 ]; then
    info 'nothing to hoist — every gitignored path is shared, derived, or already linked'
  else
    printf '\n'
    info "hoist with: share <path>...   (build output is excluded; --force to override)"
  fi
  exit 0
fi

# ------------------------------------------------------- share <path>...: hoist
status=0
hoisted=0

for path in "$@"; do
  [ -e "$path" ] || {
    warn "does not exist: $path"
    status=1
    continue
  }

  if [ -L "$path" ]; then
    warn "already a symlink, skipping: $path"
    continue
  fi

  abs=$(cd -- "$(dirname -- "$path")" && pwd -P)/$(basename -- "$path") ||
    { warn "could not resolve: $path"; status=1; continue; }

  case "$abs" in
    "$worktree"/*) ;;
    *)
      warn "outside this worktree, skipping: $path"
      status=1
      continue
      ;;
  esac

  rel=${abs#"$worktree"/}

  if [ "$force" -eq 0 ] && ! (cd "$worktree" && is_local "$rel"); then
    warn "not gitignored, refusing: $rel"
    warn "  a tracked file replaced by a symlink shows up as a change in every worktree."
    warn "  gitignore it first, or re-run with --force."
    status=1
    continue
  fi

  if [ "$force" -eq 0 ] && is_derived "$rel"; then
    warn "build output, refusing: $rel"
    warn "  derived artifacts are per-branch; sharing them races across worktrees."
    warn "  re-run with --force if you really mean it."
    status=1
    continue
  fi

  if [ -e "$shared/$rel" ]; then
    warn "already shared, skipping: $rel"
    continue
  fi

  mkdir -p "$shared/$(dirname -- "$rel")" || {
    warn "could not create parent in _shared for: $rel"
    status=1
    continue
  }

  mv -- "$abs" "$shared/$rel" || {
    warn "could not move: $rel"
    status=1
    continue
  }

  info "hoisted $rel -> _shared/$rel"
  hoisted=1
done

# Let the linker put the symlinks back — in every worktree, not just this one.
if [ "$hoisted" -eq 1 ]; then
  for wt in $(git --git-dir "$project/.bare" worktree list --porcelain |
    sed -n 's|^worktree ||p'); do
    [ "$wt" = "$project/.bare" ] && continue
    [ -d "$wt" ] || continue
    "$linker" "$wt" >/dev/null 2>&1 || warn "could not link into $wt"
  done
  info 'linked into every worktree'
fi

exit "$status"
