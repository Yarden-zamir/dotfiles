#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# ///
"""Open URLs, files and folders from pane text (plugin yarden.links).

usage: links open [TARGET]   open TARGET: http(s) URL, file:// URL, or a
                             path with an optional :line[:col] suffix.
                             Default TARGET: $HERDR_PLUGIN_CLICKED_URL
                             (a Ctrl-clicked OSC 8 file:// link).
       links pick            popup: list the visible URLs and existing paths
                             of the focused pane, open the pick.
       links candidates      print candidate rows for the text on stdin.
options:
       --cwd DIR             base for relative paths (default: the focused
                             pane cwd from HERDR_PLUGIN_CONTEXT_JSON)
       --from FILE           pick: read this file instead of the pane
       --print               print the resolved action, run nothing

Directories open as a herdr space (bin/herdr-open-path), files open in
the editor from links.toml (default `code -g`), URLs in the browser.
Config: $HERDR_PLUGIN_CONFIG_DIR/links.toml, key `editor` (argv list; the
file, with `:line` when known, is appended). Stdlib only.
"""
import json
import os
import subprocess
import sys
import tomllib
from dataclasses import dataclass
from pathlib import Path
from typing import Literal
from urllib.parse import unquote, urlsplit

PLUGIN_DIR = Path(__file__).resolve().parent
# dotfiles/main/.config/herdr/plugins/links -> dotfiles/main
DOTFILES = PLUGIN_DIR.parents[3]
OPEN_PATH = DOTFILES / "bin" / "herdr-open-path"
HERDR = os.environ.get("HERDR_BIN_PATH") or os.path.expanduser("~/.local/bin/herdr")
# Shared fzf helpers of the palette plugin (same repo, stdlib only).
sys.path.insert(0, str(PLUGIN_DIR.parent / "palette"))
from common import DIM, RESET, fzf, fzf_args  # noqa: E402

Kind = Literal["url", "dir", "file"]

# Characters that wrap a token in prose and code: quotes, brackets, and
# sentence punctuation. Stripped from both ends until none remain.
WRAPPERS = "\"'`<>[]{}(),;!?"
URL_PREFIXES = ("http://", "https://")
DEFAULT_EDITOR = ["code", "-g"]


@dataclass(frozen=True)
class Candidate:
    kind: Kind
    target: str
    line: int | None = None
    col: int | None = None

    @property
    def location(self) -> str:
        """The target with `:line[:col]` for editors and display."""
        suffix = "".join(f":{n}" for n in (self.line, self.col) if n is not None)
        return self.target + suffix

    def row(self) -> str:
        return f"{self.kind}\t{self.location}"


def context() -> dict:
    raw = os.environ.get("HERDR_PLUGIN_CONTEXT_JSON", "")
    if not raw:
        return {}
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return {}


def editor_command() -> list[str]:
    config_dir = os.environ.get("HERDR_PLUGIN_CONFIG_DIR")
    file = Path(config_dir) / "links.toml" if config_dir else None
    if file is None:
        return DEFAULT_EDITOR
    if not file.exists():
        file.parent.mkdir(parents=True, exist_ok=True)
        file.write_text(
            "# Editor for files opened by the links plugin. The file path, with\n"
            "# `:line` when known, is appended as the last argument.\n"
            f"editor = {json.dumps(DEFAULT_EDITOR)}\n"
        )
        return DEFAULT_EDITOR
    with file.open("rb") as fh:
        editor = tomllib.load(fh).get("editor", DEFAULT_EDITOR)
    if not isinstance(editor, list) or not all(isinstance(part, str) for part in editor) or not editor:
        sys.exit(f"links: `editor` in {file} must be a non-empty list of strings")
    return editor


def split_location(token: str) -> tuple[str, int | None, int | None]:
    """Split `path:line[:col]` into parts. Only trailing numbers count."""
    numbers: list[int] = []
    rest = token
    while len(numbers) < 2:
        head, sep, tail = rest.rpartition(":")
        if not sep or not tail.isdigit():
            break
        numbers.insert(0, int(tail))
        rest = head
    line = numbers[0] if numbers else None
    col = numbers[1] if len(numbers) == 2 else None
    return rest, line, col


def classify_path(token: str, cwd: Path) -> Candidate | None:
    """A token is a path when it exists on disk, as given, expanded, or
    relative to cwd. Existence is the filter: it keeps prose words out."""
    bare, line, col = split_location(token)
    if not bare or bare.startswith("-"):
        return None
    # Keep the existence checks off plain words: a path has a separator, a
    # home or dot prefix, or an extension dot.
    if not ("/" in bare or bare.startswith(("~", ".")) or "." in bare):
        return None
    path = Path(os.path.expanduser(bare))
    if not path.is_absolute():
        path = cwd / path
    if not path.exists():
        return None
    resolved = str(path.resolve())
    if path.is_dir():
        return Candidate("dir", resolved)
    return Candidate("file", resolved, line, col)


def classify(token: str, cwd: Path) -> Candidate | None:
    token = token.strip(WRAPPERS).rstrip(".:")
    if not token:
        return None
    if token.startswith(URL_PREFIXES):
        return Candidate("url", token)
    if token.startswith("file://"):
        return classify_file_url(token, cwd)
    return classify_path(token, cwd)


def classify_file_url(url: str, cwd: Path) -> Candidate | None:
    parts = urlsplit(url)
    path = unquote(parts.path)
    line: int | None = None
    # `#L27` is the GitHub style fragment agents use for a line.
    fragment = parts.fragment
    if fragment.startswith("L") and fragment[1:].isdigit():
        line = int(fragment[1:])
    found = classify_path(path, cwd)
    if found is None or found.kind != "file" or line is None:
        return found
    return Candidate("file", found.target, line)


def candidates(text: str, cwd: Path) -> list[Candidate]:
    """Unique candidates, last occurrence on screen first (newest output
    is at the bottom of a pane). Limit: parentheses split tokens, so a URL
    with parentheses loses its tail; revisit if such URLs show up often."""
    seen: dict[str, Candidate] = {}
    for line in reversed(text.splitlines()):
        for raw in line.replace("(", " ").replace(")", " ").split():
            found = classify(raw, cwd)
            if found is not None and found.location not in seen:
                seen[found.location] = found
    return list(seen.values())


def open_command(candidate: Candidate) -> list[str]:
    if candidate.kind == "url":
        opener = "open" if sys.platform == "darwin" else "xdg-open"
        return [opener, candidate.target]
    if candidate.kind == "dir":
        return [str(OPEN_PATH), candidate.target]
    # An editor `:col` suffix is editor specific; `code -g` takes line:col.
    return [*editor_command(), candidate.location]


def run(candidate: Candidate, print_only: bool) -> None:
    command = open_command(candidate)
    if print_only:
        print(json.dumps({"kind": candidate.kind, "target": candidate.location, "command": command}))
        return
    subprocess.run(command, check=True)


def toast(title: str, body: str) -> None:
    subprocess.run([HERDR, "notification", "show", title, "--body", body],
                   capture_output=True)


def base_cwd(args: list[str]) -> Path:
    if "--cwd" in args:
        return Path(args[args.index("--cwd") + 1])
    ctx = context()
    cwd = ctx.get("focused_pane_cwd") or ctx.get("workspace_cwd") or os.getcwd()
    return Path(cwd)


def cmd_open(args: list[str], print_only: bool) -> None:
    positional = [a for a in args if not a.startswith("--") and a != base_cwd_arg(args)]
    target = positional[0] if positional else os.environ.get("HERDR_PLUGIN_CLICKED_URL", "")
    if not target:
        sys.exit("links open: no target (argument or HERDR_PLUGIN_CLICKED_URL)")
    found = classify(target, base_cwd(args))
    if found is None:
        toast("links: not found", target)
        sys.exit(f"links open: not a URL or an existing path: {target}")
    run(found, print_only)


def base_cwd_arg(args: list[str]) -> str | None:
    return args[args.index("--cwd") + 1] if "--cwd" in args else None


def pane_text(args: list[str]) -> str:
    if "--from" in args:
        return Path(args[args.index("--from") + 1]).read_text()
    pane_id = context().get("focused_pane_id")
    if not pane_id:
        sys.exit("links pick: no focused pane in HERDR_PLUGIN_CONTEXT_JSON")
    out = subprocess.run([HERDR, "pane", "read", pane_id, "--source", "visible"],
                         capture_output=True, text=True, check=True)
    return out.stdout


def cmd_pick(args: list[str], print_only: bool) -> None:
    found = candidates(pane_text(args), base_cwd(args))
    if not found:
        print("links: no URL or existing path on screen")
        return
    rows = [f"{DIM}{c.kind:<4}{RESET}\t{c.location}" for c in found]
    picked = fzf([*fzf_args("open"), "--delimiter=\t", "--nth=2", "--no-sort"], rows)
    if picked.returncode != 0 or not picked.stdout.strip():
        return
    location = picked.stdout.rstrip("\n").split("\t", 1)[1]
    choice = next(c for c in found if c.location == location)
    run(choice, print_only)


def cmd_candidates(args: list[str]) -> None:
    for c in candidates(sys.stdin.read(), base_cwd(args)):
        print(c.row())


def main(argv: list[str]) -> None:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    command, *args = argv
    print_only = "--print" in args
    match command:
        case "open":
            cmd_open(args, print_only)
        case "pick":
            cmd_pick(args, print_only)
        case "candidates":
            cmd_candidates(args)
        case _:
            sys.exit(f"links: unknown command {command}\n\n{__doc__.strip()}")


if __name__ == "__main__":
    main(sys.argv[1:])
