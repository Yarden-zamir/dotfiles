#!/bin/sh
# herdr [ui.toast.system] command: post a macOS notification. A click shows
# the source pane in herdr and brings Ghostty to the front.
# herdr passes the notification in HERDR_NOTIFICATION_* variables. Remote
# (SSH) notifications carry no pane id, so a click only activates Ghostty.
# Limit: needs terminal-notifier registered with LaunchServices. macOS 26
# refuses an unregistered copy (exit 3). After a brew reinstall, run
# lsregister -f on the terminal-notifier.app bundle again.
set -eu

# The server's PATH may lack Homebrew; search the usual install dirs.
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
notifier=$(command -v terminal-notifier) || { echo "notify: terminal-notifier not found in PATH" >&2; exit 1; }
herdr=${HERDR_BIN_PATH:-herdr}
pane=${HERDR_NOTIFICATION_PANE_ID:-}
tab=${HERDR_NOTIFICATION_TAB_ID:-}

# Quote a value for the sh command line that terminal-notifier runs on click.
quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

on_click=:
if [ -n "$pane" ]; then
    on_click="$(quote "$herdr") agent focus $(quote "$pane")"
    [ -n "$tab" ] && on_click="$on_click || $(quote "$herdr") tab focus $(quote "$tab")"
fi

# Print the last text line of the last Claude reply in this pane. Read only
# the transcript tail, because transcripts grow to megabytes.
# Limit: Claude only. Add a reader when another agent needs the last line.
last_reply_line() {
    [ -n "$pane" ] && [ "${HERDR_NOTIFICATION_AGENT:-}" = claude ] || return 0
    session=$("$herdr" agent get "$pane" | jq -r '.result.agent.agent_session.value // empty')
    [ -n "$session" ] || return 0
    for transcript in "$HOME"/.claude/projects/*/"$session".jsonl; do
        [ -f "$transcript" ] || continue
        tail -n 200 "$transcript" |
            jq -r 'select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text' |
            grep -v '^[[:space:]]*$' | tail -n 1
        return 0
    done
}

# Drop Private Use Area glyphs (the Nerd Font icon in space labels):
# Notification Center has no font for them and shows a "?" box.
strip_icons() { jq -Rr 'explode | map(select(. < 57344 or . > 63743)) | implode | ltrimstr(" ")'; }
# Keep the end of a long reply. An expanded notification shows about ten
# lines (measured: 320 characters fit, 350 cut), so the start goes and the
# ending stays. Cut at a word boundary.
# Limit: 300 characters; retune if macOS changes the expanded size.
reply_tail() { jq -Rr --argjson n 300 'if length <= $n then . else .[-$n:] | "…" + .[(index(" ") // -1) + 1:] end'; }

context=$(printf '%s\n' "${HERDR_NOTIFICATION_BODY:-}" | strip_icons)
reply=$(last_reply_line 2>/dev/null | reply_tail) || reply=
# terminal-notifier drops a message that starts with "["; escape it.
case $reply in "["*) reply="\\$reply" ;; esac

# With a reply line: the context is the title and the reply is the message.
# Without one: herdr's title ("claude finished") and the context.
if [ -n "$reply" ] && [ -n "$context" ]; then
    title=$context message=$reply
else
    title=$HERDR_NOTIFICATION_TITLE message=${reply:-$context}
fi

exec "$notifier" \
    -title "$title" \
    -message "$message" \
    -group "herdr-${pane:-$HERDR_NOTIFICATION_KIND}" \
    -execute "$on_click" \
    -activate com.mitchellh.ghostty
