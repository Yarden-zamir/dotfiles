font-size=20
theme="Light Owl"
# Pseudo fullscreen like the iTerm hotkey window: cover the whole
# screen, Dock and menu bar included, without a macOS Space.
fullscreen=true
font-family="JetBrains Mono Nerd Font"
foreground=#000000
background=#FFFFFF
palette=7=#7A7A7A
palette=8=#5C5C5C
palette=15=#A0A0A0
bold-color=bright
font-thicken=true
font-thicken-strength=0
window-colorspace = display-p3
window-theme=ghostty
macos-titlebar-style = hidden

shell-integration-features=no-title

macos-non-native-fullscreen = padded-notch
window-save-state = never
macos-option-as-alt = true

# Every Ghostty window is a herdr client. Raycast launchers override
# command with --config-entry, so they stay plain windows.
command = /Users/kcw/.local/bin/herdr

# Herdr owns tabs, splits and panes. Unbind Ghostty defaults so the keys
# reach herdr through the kitty keyboard protocol. Keybinds for herdr and
# for the ZLE editor live in .config/herdr/config.toml and
# zshrc/post-init/zle-kitty-protocol.zsh.
keybind=super+t=unbind
keybind=super+shift+t=unbind
keybind=super+shift+p=unbind
keybind=super+w=unbind
keybind=super+shift+w=unbind
keybind=super+alt+w=unbind
keybind=super+d=unbind
keybind=super+shift+d=unbind
keybind=super+b=unbind
keybind=super+p=unbind
keybind=super+e=unbind
keybind=super+r=unbind
# macOS Ghostty swallows unbound physical super+digits and its esc: binds
# do not fire for them; send the alt+digit CSI-u press herdr accepts.
keybind=super+physical:one=text:\x1b[49;3u
keybind=super+physical:two=text:\x1b[50;3u
keybind=super+physical:three=text:\x1b[51;3u
keybind=super+physical:four=text:\x1b[52;3u
keybind=super+physical:five=text:\x1b[53;3u
keybind=super+physical:six=text:\x1b[54;3u
keybind=super+physical:seven=text:\x1b[55;3u
keybind=super+physical:eight=text:\x1b[56;3u
keybind=super+physical:nine=text:\x1b[57;3u
keybind=super+alt+physical:one=text:\x1b[49;7u
keybind=super+alt+physical:two=text:\x1b[50;7u
keybind=super+alt+physical:three=text:\x1b[51;7u
keybind=super+alt+physical:four=text:\x1b[52;7u
keybind=super+alt+physical:five=text:\x1b[53;7u
keybind=super+alt+physical:six=text:\x1b[54;7u
keybind=super+alt+physical:seven=text:\x1b[55;7u
keybind=super+alt+physical:eight=text:\x1b[56;7u
keybind=super+alt+physical:nine=text:\x1b[57;7u
keybind=super+alt+arrow_left=unbind
keybind=super+alt+arrow_right=unbind
keybind=super+alt+arrow_up=unbind
keybind=super+alt+arrow_down=unbind
keybind=super+ctrl+arrow_left=unbind
keybind=super+ctrl+arrow_right=unbind
keybind=super+ctrl+arrow_up=unbind
keybind=super+ctrl+arrow_down=unbind
keybind=super+shift+enter=unbind

# Editor keys go to ZLE (through herdr), not to Ghostty.
keybind=super+a=unbind
keybind=super+c=unbind
keybind=super+z=unbind
keybind=super+shift+z=unbind
keybind=super+arrow_left=unbind
keybind=super+arrow_right=unbind
keybind=super+arrow_up=unbind
keybind=super+arrow_down=unbind
keybind=super+shift+arrow_left=unbind
keybind=super+shift+arrow_right=unbind
keybind=super+shift+arrow_up=unbind
keybind=super+shift+arrow_down=unbind
keybind=super+backspace=unbind
# Herdr has no forward-delete key name; send ^K (delete to line end) directly.
keybind=super+delete=text:\x0b
keybind=super+shift+c=copy_to_clipboard

# Global shortcuts. § is a logical codepoint trigger: the physical name
# intl_backslash validates but does not register as a global hotkey.
# The bind consumes § system-wide (acceptable: never typed). If § stops
# to work under a non-Latin input source, that is the known Ghostty
# logical-trigger quirk; f17 is the fallback.
keybind=global:f17=toggle_visibility
keybind=global:§=toggle_visibility

copy-on-select=clipboard


confirm-close-surface=false
