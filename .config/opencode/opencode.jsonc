{
  "$schema": "https://opencode.ai/config.json",
  // Agents run bash. See .bashrc.
  "shell": "/opt/homebrew/bin/bash",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    },
  }
}
