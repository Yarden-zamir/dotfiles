{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "input.line.home": "ctrl+a,super+left",
    "input.line.end": "ctrl+e,super+right",
    "input.select.line.home": "ctrl+shift+a,super+shift+left",
    "input.select.line.end": "ctrl+shift+e,super+shift+right",
    "input.buffer.home": "home,super+up",
    "input.buffer.end": "end,super+down",
    "input.select.buffer.home": "shift+home,super+shift+up",
    "input.select.buffer.end": "shift+end,super+shift+down"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "editor": false,
    "paste": "compact"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "plugins": ["./herdr-opencode"]
}
