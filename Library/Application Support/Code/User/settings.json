    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "dataWrangler.experiments.copilot.enabled": true,
  "github.copilot.chat.generateTests.codeLens": true,
  "gitlens.mode.active": "review",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "zig.zls.enabled": "on",
  "claudeCode.preferredLocation": "sidebar",
  "editor.fontFamily": "JetBrainsMono NF, Monaco, 'Courier New', monospace",
  "excalidraw.theme": "light",
  "claudeCode.selectedModel": "default",
  "git.confirmSync": false,
  "json.schemaDownload.trustedDomains": {
    "https://opencode.ai/": true,
    "https://models.dev/": true
  },
  "resharper.region.region": "MiddleEast",
  "resharper.dataSharing.allowDataSharing": false,
  "workbench.sideBar.location": "right",
  "workbench.tips.enabled": false,
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.scrollToSwitchTabs": true,
  "workbench.editor.showTabIndex": true,
  "workbench.editor.tabActionCloseVisibility": false,
  "workbench.editor.tabActionUnpinVisibility": false,
  "workbench.editor.tabSizing": "fixed",
  "workbench.editor.tabSizingFixedMaxWidth": 1600,
  "workbench.editor.useModal": "off",
  "workbench.settings.alwaysShowAdvancedSettings": true,
  "problems.showCurrentInStatus": true,
  "editor.formatOnSave": true,
  "githubPullRequests.autoRepositoryDetection": true,
  "githubPullRequests.queries": [
    {
      "label": "Local Pull Request Branches",
      "query": "default"
    },
    {
      "label": "Waiting For My Review",
      "query": "repo:${owner}/${repository} is:open review-requested:${user}"
    },
    {
      "label": "Created By Me",
      "query": "repo:${owner}/${repository} is:open author:${user}"
    },
    {
      "label": "All Open",
      "query": "default"
    }
  ],
  "workbench.browser.showInTitleBar": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "gitlens.rebaseEditor.ordering": "asc",
  "git.detectWorktrees": true,
  "window.title": "${activeEditorShort}${separator}${activeRepositoryName}${separator}${activeRepositoryBranchName}${separator}${profileName} (${folderPath})",
  "editor.renderControlCharacters": false,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilotcli:claude-sonnet-5",
  "chat.tools.terminal.autoApprove": {
